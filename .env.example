# Database Configuration (Supabase Transaction Pooler recommended for Vercel, port 6543)
DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=postgres

# Initial Admin Account
ADMIN_USERNAME=SuperAdmin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password

# AI Service (Typhoon)
TYPHOON_BASE_URL=https://api.opentyphoon.ai/v1
TYPHOON_API_KEY=your_typhoon_api_key_here

# Frontend Configuration & CORS
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000
